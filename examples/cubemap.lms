# Magnum example "Cube Map" (https://magnum.graphics/doc/magnum/examples-cubemap.html), reproduced headless: the original renders a skybox cube map and an object reflecting it. Here a six-sided room (each face its own colour, the cube-map faces) surrounds three glossy spheres; the reflection itself needs an environment lookup the rasterizers lack.
out = ARGV.len() > 0 ? ARGV[0] : "build/cubemap.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
let right = material().color(0.85, 0.25, 0.22).specular(0.05);
let left = material().color(0.25, 0.7, 0.35).specular(0.05);
let top = material().color(0.8, 0.85, 0.95).specular(0.05);
let bottom = material().color(0.3, 0.3, 0.34).specular(0.05);
let front = material().color(0.92, 0.8, 0.25).specular(0.05);
let back = material().color(0.25, 0.4, 0.85).specular(0.05);
let chrome = material().color(0.9, 0.9, 0.92).roughness(0.05).specular(0.9).shininess(120.0);
scene.box(0.2, 20.0, 20.0, right).translate(10.0, 0.0, 0.0);
scene.box(0.2, 20.0, 20.0, left).translate(-10.0, 0.0, 0.0);
scene.box(20.0, 0.2, 20.0, top).translate(0.0, 10.0, 0.0);
scene.box(20.0, 0.2, 20.0, bottom).translate(0.0, -10.0, 0.0);
scene.box(20.0, 20.0, 0.2, front).translate(0.0, 0.0, -10.0);
scene.box(20.0, 20.0, 0.2, back).translate(0.0, 0.0, 10.0);
scene.sphere(1.6, chrome).translate(0.0, 0.0, 0.0);
scene.sphere(0.9, chrome).translate(-3.5, -1.0, -2.0);
scene.sphere(0.9, chrome).translate(3.5, -1.0, -2.0);
scene.ambient(0.45);
scene.camera(70.0, 0.0, 0.5, 8.5, 0.0, 0.0, 0.0);
scene.directional_light(-0.2, -0.7, -0.6, 0.6);
scene.render_png("images/cubemap.png", 800, 600);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--lmcode", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/cubemap.png");
