# Level 3: a hands-off Lead: one of the four 10 s clips (240 frames at 24 fps) on https://lmctl.com, from lmctl-ai/lmctl scripts/homepage/video.
# A requirement and its acceptance checklist enter, the Lead assigns work and a reviewed result returns.
# Writes images/level-3-hands-off-lead.png (frame 150), images/level-3-hands-off-lead.mp4 and images/level-3-hands-off-lead.gif (the last two need ffmpeg) and build/level-3-hands-off-lead/frame-N.png.
out = ARGV.len() > 0 ? ARGV[0] : "build/level-3-hands-off-lead.dslb";
mkdir("images");
mkdir("build");
mkdir("build/level-3-hands-off-lead");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
let frame_count = 240;
let render_width = 480;
let render_height = 270;
let blue = material().color(0.18, 0.60, 0.94).specular(0.18).shininess(22.0);
let teal = material().color(0.14, 0.78, 0.68).specular(0.20).shininess(24.0);
let gold = material().color(0.98, 0.68, 0.20).specular(0.22).shininess(26.0);
let violet = material().color(0.62, 0.45, 0.94).specular(0.18).shininess(22.0);
let coral = material().color(0.96, 0.38, 0.28).specular(0.18).shininess(22.0);
let green = material().color(0.28, 0.80, 0.48).specular(0.18).shininess(22.0);

# Shared look block: keep identical in all four homepage storyboards.
scene.background(0.035, 0.055, 0.10);
scene.directional_light(-0.55, -1.0, -0.45, 0.82);
scene.ambient(0.19);

# A person defines the request. The checklist is a panel with three marks.
let human_left = scene.sphere(0.70, teal).translate(-8.0, 0.9, 0.0);
let human_left_body = scene.cylinder(0.48, 1.4, teal).translate(-8.0, -0.45, 0.0);
let checklist = scene.box(1.25, 1.45, 0.22, gold).translate(-6.1, 0.1, 0.2);
let mark0 = scene.box(0.58, 0.08, 0.08, blue).translate(-6.1, 0.5, 0.38);
let mark1 = scene.box(0.58, 0.08, 0.08, blue).translate(-6.1, 0.1, 0.38);
let mark2 = scene.box(0.58, 0.08, 0.08, blue).translate(-6.1, -0.3, 0.38);

# The Lead coordinates two members in the middle of the workflow.
let lead = scene.sphere(0.76, gold).translate(0.0, 0.4, 0.0);
let coder = scene.sphere(0.56, blue).translate(-2.5, -1.5, 0.0);
let reviewer = scene.sphere(0.56, violet).translate(2.5, -1.5, 0.0);
let left_link = scene.box(2.6, 0.08, 0.12, blue).translate(-1.3, -0.6, -0.7);
let right_link = scene.box(2.6, 0.08, 0.12, violet).translate(1.3, -0.6, -0.7);

# A second person receives and reviews the finished result.
let human_right = scene.sphere(0.70, teal).translate(8.0, 0.9, 0.0).visible(false);
let human_right_body = scene.cylinder(0.48, 1.4, teal).translate(8.0, -0.45, 0.0).visible(false);
let result = scene.box(0.72, 0.72, 0.5, green).translate(0.0, 0.4, 0.4).visible(false);
let work_packet = scene.sphere(0.24, coral);
let review_packet = scene.sphere(0.24, gold);
let camera = scene.camera(68.6, 0.0, 0.0, 16.5, 0.0, 0.0, 0.0);
for (frame in range(0, frame_count)) {
  let t = float(frame) / float(frame_count - 1);
  let request_t = ease(clamp(t / 0.32, 0.0, 1.0));
  let checklist_x = lerp(-6.1, -2.6, request_t);
  checklist.translate(checklist_x, 0.1, 0.2);
  mark0.translate(checklist_x, 0.5, 0.38);
  mark1.translate(checklist_x, 0.1, 0.38);
  mark2.translate(checklist_x, -0.3, 0.38);
  checklist.visible(t < 0.40); mark0.visible(t < 0.40); mark1.visible(t < 0.40); mark2.visible(t < 0.40);
  human_left.visible(t < 0.40); human_left_body.visible(t < 0.40);
  human_right.visible(t > 0.86); human_right_body.visible(t > 0.86);

  let activity = 0.10 * sin(t * 18.8496);
  coder.translate(-2.5, -1.5 + activity, 0.0);
  reviewer.translate(2.5, -1.5 - activity, 0.0);
  lead.translate(0.0, 0.4 + 0.06 * cos(t * 18.8496), 0.0);

  let message_cycle = float(frame % 72) / 71.0;
  if (message_cycle < 0.5) {
    let message_t = ease(message_cycle * 2.0);
    work_packet.translate(lerp(-2.5, 0.0, message_t), lerp(-1.5, 0.4, message_t), 0.75);
    review_packet.translate(lerp(0.0, 2.5, message_t), lerp(0.4, -1.5, message_t), 0.78);
  } else {
    let message_t = ease((message_cycle - 0.5) * 2.0);
    work_packet.translate(lerp(0.0, -2.5, message_t), lerp(0.4, -1.5, message_t), 0.75);
    review_packet.translate(lerp(2.5, 0.0, message_t), lerp(-1.5, 0.4, message_t), 0.78);
  }

  let result_t = ease(clamp((t - 0.70) / 0.30, 0.0, 1.0));
  result.translate(lerp(0.0, 6.7, result_t), 0.45, 0.65);
  result.visible(t > 0.70);
  scene.render_png("build/level-3-hands-off-lead/frame-" + str(frame) + ".png", render_width, render_height);
  if (frame == 150) { scene.render_png("images/level-3-hands-off-lead.png", render_width, render_height); }
}
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (the 240 frames take a while: 10 min limit)
r = system(concat(dsl_cli(p), ["--lmcode", out]), 3000000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/level-3-hands-off-lead.png");
if (which("ffmpeg") != null) {
  a = system ffmpeg -y -loglevel error -framerate 24 -i build/level-3-hands-off-lead/frame-%d.png -c:v libx264 -pix_fmt yuv420p -crf 22 images/level-3-hands-off-lead.mp4;
  assert(a.code == 0);
  b = system ffmpeg -y -loglevel error -framerate 24 -i build/level-3-hands-off-lead/frame-%d.png -vf "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=64[p];[b][p]paletteuse=dither=none" -loop 0 images/level-3-hands-off-lead.gif;
  assert(b.code == 0);
  println("wrote images/level-3-hands-off-lead.mp4 and images/level-3-hands-off-lead.gif");
} else {
  println("ffmpeg not found: skipped the MP4 and GIF (build/level-3-hands-off-lead/frame-*.png are the 240 frames)");
}
