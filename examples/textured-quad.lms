# Textured Quad
# Magnum example "Textured Quad" (https://magnum.graphics/doc/magnum/examples-texturedquad.html), reproduced headless: a quad built from two triangles; image import and shaders do not exist in the host, so a checker is made from alternating tiles.
out = ARGV.len() > 0 ? ARGV[0] : "build/textured-quad.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
scene.background(0.1, 0.1, 0.12);
let a = material().color(0.95, 0.95, 0.9).specular(0.0);
let b = material().color(0.15, 0.2, 0.55).specular(0.0);
for (i in range(0, 8)) {
  for (j in range(0, 8)) {
    let x = (float(i) - 3.5) * 0.25;
    let y = (float(j) - 3.5) * 0.25;
    if ((i + j) % 2 == 0) {
      scene.plane(0.25, a).translate(x, y, 0.0);
    } else {
      scene.plane(0.25, b).translate(x, y, 0.0);
    }
  }
}
scene.camera(40.0, 0.0, 0.0, 3.2, 0.0, 0.0, 0.0);
scene.directional_light(0.0, 0.0, -1.0, 0.8);
scene.render_png("images/textured-quad.png", 480, 480);
end _dsl_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/textured-quad.png");
