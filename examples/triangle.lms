# Your First Triangle
# Magnum example "Your First Triangle" (https://magnum.graphics/doc/magnum/examples-triangle.html), reproduced headless: a single flat triangle, red/green/blue vertex colours replaced by one material (no per-vertex colour yet).
out = ARGV.len() > 0 ? ARGV[0] : "build/triangle.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
scene.background(0.0, 0.0, 0.0);
scene.ambient(1.0);
let m = material().color(0.9, 0.35, 0.2).specular(0.0);
scene.triangle(-0.5, -0.5, 0.0, 0.5, -0.5, 0.0, 0.0, 0.5, 0.0, m);
scene.camera(40.0, 0.0, 0.0, 3.0, 0.0, 0.0, 0.0);
scene.directional_light(0.0, 0.0, -1.0, 0.0);
scene.render_png("images/triangle.png", 480, 360);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--lmcode", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/triangle.png");
