# The Cornell box (Cornell University, 1984): a 5.5 m white room with a red left wall, a green right wall, a ceiling lamp and two white blocks
# (the short one turned -18 degrees, the tall one 3.3 m turned 17 degrees), camera FOV 39.3 degrees as in the original setup.
# Ported from lmblender examples/cornell-box.lms; this renderer has no indirect light, so the colour bleeding the original shows is only
# hinted at by the ambient term.
out = ARGV.len() > 0 ? ARGV[0] : "build/cornell-box.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
let white = material().color(0.725, 0.71, 0.68).roughness(0.9).specular(0.05);
let red = material().color(0.63, 0.065, 0.05).roughness(0.9).specular(0.05);
let green = material().color(0.14, 0.45, 0.091).roughness(0.9).specular(0.05);
let lamp = material().color(1.0, 0.92, 0.65).specular(0.0);
scene.box(5.7, 0.1, 5.7, white).translate(0.0, -0.05, 0.0);
scene.box(5.7, 0.1, 5.7, white).translate(0.0, 5.55, 0.0);
scene.box(5.7, 5.7, 0.1, white).translate(0.0, 2.75, -2.8);
scene.box(0.1, 5.7, 5.7, red).translate(-2.8, 2.75, 0.0);
scene.box(0.1, 5.7, 5.7, green).translate(2.8, 2.75, 0.0);
scene.box(1.3, 0.02, 1.05, lamp).translate(0.0, 5.49, 0.0);
scene.box(1.65, 1.65, 1.65, white).translate(0.95, 0.825, 0.75).rotate(0.0, -18.0, 0.0);
scene.box(1.65, 3.3, 1.65, white).translate(-0.9, 1.65, -0.75).rotate(0.0, 17.0, 0.0);
scene.background(0.0, 0.0, 0.0);
scene.ambient(0.45);
scene.camera(39.3, 0.0, 2.75, 10.4, 0.0, 2.75, 0.0);
scene.directional_light(0.1, -1.0, -0.25, 0.8);
scene.render_png("images/cornell-box.png", 640, 640);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--lmcode", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/cornell-box.png");
