# Pratt truss footbridge: method of joints, solved in closed form. Span 24 m in six 4 m panels, depth 4 m, 100 kN on each of the
# five deck joints. Support reactions R = 250 kN; the middle top chord carries -450 kN (compression) and the centre vertical nothing.
# Red members are in tension, blue in compression, grey carry zero; tube radius grows with |F|.
# Ported from lmcad examples/truss-bridge.lms (only the 3D part; the lmplot elevation is left out).
out = ARGV.len() > 0 ? ARGV[0] : "build/truss-bridge.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
let steel = material().color(0.30, 0.33, 0.38).specular(0.4).shininess(30.0);
let deck_mat = material().color(0.74, 0.72, 0.68).roughness(0.8);
scene.background(1.0, 1.0, 1.0);
scene.ambient(0.3);
let n = 6;
let d = 4.0;
let h = 4.0;
let load = 100.0;
let reaction = float(n - 1) * load / 2.0;
let diag = sqrt(d * d + h * h);
let sin_t = h / diag;
let fmax = 450.0;

for (side in range(0, 2)) {
  let z = -2.6 + 5.2 * float(side);
  for (i in range(0, n + 1)) {
    scene.sphere(0.30, steel).translate(float(i) * d, 0.0, z);
    if (i > 0) {
      if (i < n) { scene.sphere(0.30, steel).translate(float(i) * d, h, z); }
    }
  }
  for (k in range(0, n)) {
    let kk = k;
    if (k >= n / 2) { kk = n - 1 - k; }
    let j = max(kk, 1);
    let m = reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0;
    let f = m / h;
    let t = abs(f) / fmax;
    scene.tube_between(float(k) * d, 0.0, z, float(k + 1) * d, 0.0, z, 0.10 + 0.16 * t, material().color(lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t)).specular(0.3));
  }
  for (k in range(1, n - 1)) {
    let kk = k;
    if (k >= n / 2) { kk = n - 1 - k; }
    let j = kk + 1;
    let m = reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0;
    let f = 0.0 - m / h;
    let t = abs(f) / fmax;
    scene.tube_between(float(k) * d, h, z, float(k + 1) * d, h, z, 0.10 + 0.16 * t, material().color(lerp(0.62, 0.14, t), lerp(0.62, 0.36, t), lerp(0.64, 0.86, t)).specular(0.3));
  }
  let fe = reaction / sin_t;
  let te = fe / fmax;
  scene.tube_between(0.0, 0.0, z, d, h, z, 0.10 + 0.16 * te, material().color(lerp(0.62, 0.14, te), lerp(0.62, 0.36, te), lerp(0.64, 0.86, te)).specular(0.3));
  scene.tube_between(float(n) * d, 0.0, z, float(n - 1) * d, h, z, 0.10 + 0.16 * te, material().color(lerp(0.62, 0.14, te), lerp(0.62, 0.36, te), lerp(0.64, 0.86, te)).specular(0.3));
  for (k in range(1, n / 2)) {
    let f = (reaction - float(k) * load) / sin_t;
    let t = f / fmax;
    scene.tube_between(float(k) * d, h, z, float(k + 1) * d, 0.0, z, 0.10 + 0.16 * t, material().color(lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t)).specular(0.3));
    scene.tube_between(float(n - k) * d, h, z, float(n - k - 1) * d, 0.0, z, 0.10 + 0.16 * t, material().color(lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t)).specular(0.3));
  }
  for (i in range(1, n)) {
    let ii = i;
    if (i > n / 2) { ii = n - i; }
    let f = 0.0;
    if (ii == 1) { f = load; }
    if (ii > 1) {
      if (ii < n / 2) { f = 0.0 - (reaction - float(ii) * load); }
    }
    let t = abs(f) / fmax;
    let cr = 0.62; let cg = 0.62; let cb = 0.64;
    if (f > 0.0) { cr = lerp(0.62, 0.86, t); cg = lerp(0.62, 0.18, t); cb = lerp(0.64, 0.14, t); }
    if (f < 0.0) { cr = lerp(0.62, 0.14, t); cg = lerp(0.62, 0.36, t); cb = lerp(0.64, 0.86, t); }
    scene.tube_between(float(i) * d, 0.0, z, float(i) * d, h, z, 0.10 + 0.16 * t, material().color(cr, cg, cb).specular(0.3));
  }
}
for (i in range(0, n + 1)) {
  scene.tube_between(float(i) * d, -0.05, -2.6, float(i) * d, -0.05, 2.6, 0.12, steel);
  if (i > 0) {
    if (i < n) {
      scene.tube_between(float(i) * d, h, -2.6, float(i) * d, h, 2.6, 0.09, steel);
    }
  }
}
scene.box(float(n) * d + 1.2, 0.22, 4.6, deck_mat).translate(float(n) * d / 2.0, -0.30, 0.0);
scene.camera(55.0, 1.0, 9.5, 27.0, 12.0, 1.3, 0.0);
scene.directional_light(-0.35, -0.85, -0.45, 0.95);
scene.render_png("images/truss-bridge.png", 900, 400);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/truss-bridge.png");
