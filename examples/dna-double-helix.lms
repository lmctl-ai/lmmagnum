# B-DNA built from its textbook numbers (one scene unit = 1 nm): 10.5 base pairs per turn (34.3 degrees of twist per pair),
# 0.338 nm rise, phosphate backbone at radius 0.89 nm. The two backbones sit 144 degrees apart around the axis rather than 180,
# which opens a wide major groove and a narrow minor groove. 28 base pairs, axis along x.
# Base colours: A green, T red, G yellow, C blue. Ported from lmblender examples/dna-double-helix.lms.
out = ARGV.len() > 0 ? ARGV[0] : "build/dna-double-helix.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
let base_a = material().color(0.20, 0.72, 0.30).roughness(0.4).specular(0.4);
let base_t = material().color(0.85, 0.16, 0.14).roughness(0.4).specular(0.4);
let base_g = material().color(0.95, 0.66, 0.10).roughness(0.4).specular(0.4);
let base_c = material().color(0.15, 0.36, 0.90).roughness(0.4).specular(0.4);
let back1 = material().color(0.92, 0.90, 0.86).roughness(0.3).specular(0.5);
let back2 = material().color(0.55, 0.60, 0.70).roughness(0.3).specular(0.5);
let pairs = 28;
let rise = 0.338;
let twist = 34.3 * 3.14159265 / 180.0;
let groove = 144.0 * 3.14159265 / 180.0;
let radius = 0.89;
let half = float(pairs - 1) * rise * 0.5;
let lift = 1.6;
let steps = (pairs - 1) * 4;
let px1 = 0.0; let py1 = 0.0; let pz1 = 0.0;
let px2 = 0.0; let py2 = 0.0; let pz2 = 0.0;
for (s in range(0, steps + 1)) {
  let t = float(s) / 4.0;
  let x = t * rise - half;
  let a = t * twist;
  let y1 = lift + radius * sin(a);
  let z1 = 0.0 - radius * cos(a);
  let y2 = lift + radius * sin(a + groove);
  let z2 = 0.0 - radius * cos(a + groove);
  if (s > 0) {
    scene.tube_between(px1, py1, pz1, x, y1, z1, 0.11, back1);
    scene.tube_between(px2, py2, pz2, x, y2, z2, 0.11, back2);
  }
  px1 = x; py1 = y1; pz1 = z1;
  px2 = x; py2 = y2; pz2 = z2;
}
for (i in range(0, pairs)) {
  let x = float(i) * rise - half;
  let a = float(i) * twist;
  let y1 = lift + radius * sin(a);
  let z1 = 0.0 - radius * cos(a);
  let y2 = lift + radius * sin(a + groove);
  let z2 = 0.0 - radius * cos(a + groove);
  let ym = (y1 + y2) * 0.5;
  let zm = (z1 + z2) * 0.5;
  scene.sphere(0.17, back1).translate(x, y1, z1);
  scene.sphere(0.17, back2).translate(x, y2, z2);
  let code = (i * 7 + i * i * 3 + 1) - 4 * int(float(i * 7 + i * i * 3 + 1) / 4.0);
  let left = scene.tube_between(x, y1, z1, x, ym, zm, 0.075, base_a);
  let right = scene.tube_between(x, ym, zm, x, y2, z2, 0.075, base_a);
  if (code == 0) { left.color(0.20, 0.72, 0.30); right.color(0.85, 0.16, 0.14); }
  if (code == 1) { left.color(0.85, 0.16, 0.14); right.color(0.20, 0.72, 0.30); }
  if (code == 2) { left.color(0.95, 0.66, 0.10); right.color(0.15, 0.36, 0.90); }
  if (code == 3) { left.color(0.15, 0.36, 0.90); right.color(0.95, 0.66, 0.10); }
}
scene.background(0.03, 0.035, 0.05);
scene.ambient(0.25);
scene.camera(50.0, 0.0, 6.2, 11.0, 0.0, 1.35, 0.0);
scene.directional_light(-0.3, -0.6, -0.7, 0.95);
scene.render_png("images/dna-double-helix.png", 900, 500);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/dna-double-helix.png");
