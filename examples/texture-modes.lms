# Texture filtering and wrapping
# One 8x8 pixel-art texture on six quads: the top row magnifies it with linear (smooth) and nearest (crisp) filtering, then shows a checker at a grazing angle (trilinear mip filtering); the bottom row repeats the quad's UVs 2.5 times with wrap "repeat", "clamp" (edge pixels stretch) and "mirror".
out = ARGV.len() > 0 ? ARGV[0] : "build/texture-modes.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
scene.background(0.09, 0.1, 0.13);
let lin = scene.texture(8, 8);
let nea = scene.texture(8, 8);
let rep = scene.texture(8, 8);
let clp = scene.texture(8, 8);
let mir = scene.texture(8, 8);
for (y in range(0, 8)) {
  for (x in range(0, 8)) {
    let d = abs(float(x) - 3.5) + abs(float(y) - 3.5);
    let on = 0.0;
    if ((x + y) % 2 == 0) { on = 1.0; }
    let r = 0.15 + 0.2 * on;
    let g = 0.25 + 0.2 * on;
    let b = 0.55;
    if (d < 4.1) { r = 0.95; g = 0.75; b = 0.2; }
    if (x == 0) { if (y == 7) { r = 0.9; g = 0.2; b = 0.25; } }
    lin.pixel(x, y, r, g, b);
    nea.pixel(x, y, r, g, b);
    rep.pixel(x, y, r, g, b);
    clp.pixel(x, y, r, g, b);
    mir.pixel(x, y, r, g, b);
  }
}
lin.filter("linear");
nea.filter("nearest");
rep.filter("nearest").wrap("repeat").repeat(2.5, 2.5);
clp.filter("nearest").wrap("clamp").repeat(2.5, 2.5);
mir.filter("nearest").wrap("mirror").repeat(2.5, 2.5);
# a large checker seen at a grazing angle: mip levels keep the distance clean instead of shimmering
let far = scene.texture_checker(256, 32, 0.9, 0.9, 0.85, 0.2, 0.25, 0.4).repeat(3.0, 3.0);
let white = material().color(1.0, 1.0, 1.0).specular(0.0);
scene.plane(1.8, white.texture(lin)).translate(-2.1, 1.1, 0.0);
scene.plane(1.8, white.texture(nea)).translate(0.0, 1.1, 0.0);
scene.plane(2.6, white.texture(far)).rotate(-68.0, 0.0, 0.0).translate(2.1, 1.1, 0.0);
scene.plane(1.8, white.texture(rep)).translate(-2.1, -1.1, 0.0);
scene.plane(1.8, white.texture(clp)).translate(0.0, -1.1, 0.0);
scene.plane(1.8, white.texture(mir)).translate(2.1, -1.1, 0.0);
scene.camera(40.0, 0.0, 0.0, 9.0, 0.0, 0.0, 0.0);
scene.directional_light(0.0, 0.0, -1.0, 0.8);
scene.ambient(0.2);
scene.render_png("images/texture-modes.png", 640, 400);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--lmcode", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/texture-modes.png");
