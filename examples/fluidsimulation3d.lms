# Magnum example "3D Fluid Simulation" (https://magnum.graphics/doc/magnum/examples-fluidsimulation3d.html), reproduced headless as flow visualisation: Magnum's example runs a particle fluid on the GPU; there is no simulator or arrays here, so this integrates 32 streamlines of the ABC (Arnold-Beltrami-Childress) flow with midpoint steps, drawn as tube chains coloured by speed (blue slow, orange fast).
out = ARGV.len() > 0 ? ARGV[0] : "build/fluidsimulation3d.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
let aa = 1.0;
let bb = 0.8165;
let cc = 0.5774;
let dt = 0.14;
for (si in range(0, 32)) {
  let ix = si - (si / 4) * 4;
  let iy = (si / 4) - (si / 16) * 4;
  let iz = si / 16;
  let x = (float(ix) + 0.5) * 1.5708 + 0.3 * float(iz);
  let y = (float(iy) + 0.5) * 1.5708;
  let z = 1.2 + 3.0 * float(iz);
  for (step in range(0, 34)) {
    let u1 = aa * sin(z) + cc * cos(y);
    let v1 = bb * sin(x) + aa * cos(z);
    let w1 = cc * sin(y) + bb * cos(x);
    let xm = x + 0.5 * dt * u1;
    let ym = y + 0.5 * dt * v1;
    let zm = z + 0.5 * dt * w1;
    let u2 = aa * sin(zm) + cc * cos(ym);
    let v2 = bb * sin(xm) + aa * cos(zm);
    let w2 = cc * sin(ym) + bb * cos(xm);
    let nx = x + dt * u2;
    let ny = y + dt * v2;
    let nz = z + dt * w2;
    let speed = sqrt(u2 * u2 + v2 * v2 + w2 * w2);
    let t = clamp(speed / 2.2, 0.0, 1.0);
    let cr = lerp(0.2, 1.0, t);
    let cg = lerp(0.4, 0.55, t);
    let cb = lerp(1.0, 0.15, t);
    let px = x - 3.14159;  let py = y - 3.14159;  let pz = z - 3.14159;
    let qx = nx - 3.14159; let qy = ny - 3.14159; let qz = nz - 3.14159;
    let m = material().color(cr, cg, cb).specular(0.3);
    scene.tube_between(px, py, pz, qx, qy, qz, 0.05, m);
    x = nx; y = ny; z = nz;
  }
}
scene.background(0.04, 0.045, 0.07);
scene.ambient(0.3);
scene.camera(52.0, 10.0, 9.0, 13.0, 0.0, 0.0, 0.0);
scene.directional_light(-0.4, -0.7, -0.6, 0.9);
scene.render_png("images/fluidsimulation3d.png", 800, 600);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--lmcode", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/fluidsimulation3d.png");
