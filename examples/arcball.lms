# ArcBall Camera
# Magnum example "ArcBall Camera" (https://magnum.graphics/doc/magnum/examples-arcball.html), reproduced headless: scripted camera orbit instead of mouse input: 12 frames around the subject, each written as a PNG.
out = ARGV.len() > 0 ? ARGV[0] : "build/arcball.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
scene.background(0.07, 0.08, 0.11);
let m = material().color(0.8, 0.5, 0.25).specular(0.4);
scene.box(2.0, 1.0, 1.0, m);
scene.sphere(0.6, m).translate(1.4, 0.8, 0.0);
scene.directional_light(-0.5, -1.0, -0.4, 0.9);
for (f in range(0, 12)) {
  let a = float(f) * 6.28318530718 / 12.0;
  scene.camera(40.0, 6.0 * cos(a), 3.0, 6.0 * sin(a), 0.0, 0.3, 0.0);
  let name = "build/arcball-" + str(f) + ".png";
  if (f < 10) {
    name = "build/arcball-0" + str(f) + ".png";
  }
  scene.render_png(name, 320, 240);
}
end _dsl_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote build/arcball-00.png .. build/arcball-11.png");
