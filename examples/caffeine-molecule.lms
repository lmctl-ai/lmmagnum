# Caffeine (1,3,7-trimethylxanthine, C8H10N4O2) as a ball-and-stick model in CPK colours: grey carbon, blue nitrogen, red oxygen, white hydrogen.
# 24 atoms and 29 stick segments (a double bond is two), coordinates copied from the lmblender example caffeine-molecule (one scene unit is one angstrom).
# Ported from lmblender examples/caffeine-molecule.lms.
out = ARGV.len() > 0 ? ARGV[0] : "build/caffeine-molecule.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
let cpk_c = material().color(0.16, 0.17, 0.19).roughness(0.3).specular(0.5).shininess(50.0);
let cpk_n = material().color(0.1, 0.25, 0.85).roughness(0.3).specular(0.5).shininess(50.0);
let cpk_o = material().color(0.85, 0.07, 0.05).roughness(0.3).specular(0.5).shininess(50.0);
let cpk_h = material().color(0.92, 0.92, 0.9).roughness(0.3).specular(0.5).shininess(50.0);
let stick = material().color(0.62, 0.62, 0.64).roughness(0.4).specular(0.5);
scene.background(0.035, 0.045, 0.07);
scene.sphere(0.36, cpk_n).translate(-1.797, 2.0, -0.735);
scene.sphere(0.38, cpk_c).translate(-1.797, 2.0, 0.655);
scene.sphere(0.36, cpk_n).translate(-0.593, 2.0, 1.35);
scene.sphere(0.38, cpk_c).translate(0.611, 2.0, 0.655);
scene.sphere(0.38, cpk_c).translate(0.611, 2.0, -0.735);
scene.sphere(0.38, cpk_c).translate(-0.593, 2.0, -1.43);
scene.sphere(0.36, cpk_n).translate(1.933, 2.0, -1.165);
scene.sphere(0.38, cpk_c).translate(2.75, 2.0, -0.04);
scene.sphere(0.36, cpk_n).translate(1.933, 2.0, 1.084);
scene.sphere(0.36, cpk_o).translate(-2.862, 2.0, 1.27);
scene.sphere(0.36, cpk_o).translate(-0.593, 2.0, -2.66);
scene.sphere(0.38, cpk_c).translate(-3.07, 2.0, -1.47);
scene.sphere(0.38, cpk_c).translate(-0.593, 2.0, 2.82);
scene.sphere(0.38, cpk_c).translate(2.387, 2.0, -2.563);
scene.sphere(0.24, cpk_h).translate(3.83, 2.0, -0.04);
scene.sphere(0.24, cpk_h).translate(-3.385, 3.028, -1.652);
scene.sphere(0.24, cpk_h).translate(-2.94, 1.486, -2.423);
scene.sphere(0.24, cpk_h).translate(-3.83, 1.486, -0.881);
scene.sphere(0.24, cpk_h).translate(-0.593, 3.028, 3.184);
scene.sphere(0.24, cpk_h).translate(-1.483, 1.486, 3.184);
scene.sphere(0.24, cpk_h).translate(0.297, 1.486, 3.184);
scene.sphere(0.24, cpk_h).translate(2.5, 3.028, -2.909);
scene.sphere(0.24, cpk_h).translate(3.346, 1.486, -2.634);
scene.sphere(0.24, cpk_h).translate(1.653, 1.486, -3.184);
scene.tube_between(-1.797, 2.0, -0.735, -1.797, 2.0, 0.655, 0.11, stick);
scene.tube_between(-1.797, 2.0, 0.655, -0.593, 2.0, 1.35, 0.11, stick);
scene.tube_between(-0.593, 2.0, 1.35, 0.611, 2.0, 0.655, 0.11, stick);
scene.tube_between(0.611, 2.0, -0.735, -0.593, 2.0, -1.43, 0.11, stick);
scene.tube_between(-0.593, 2.0, -1.43, -1.797, 2.0, -0.735, 0.11, stick);
scene.tube_between(0.611, 2.0, -0.735, 1.933, 2.0, -1.165, 0.11, stick);
scene.tube_between(1.933, 2.0, -1.165, 2.75, 2.0, -0.04, 0.11, stick);
scene.tube_between(1.933, 2.0, 1.084, 0.611, 2.0, 0.655, 0.11, stick);
scene.tube_between(-1.732, 2.0, 0.768, -2.797, 2.0, 1.383, 0.075, stick);
scene.tube_between(-1.862, 2.0, 0.542, -2.927, 2.0, 1.157, 0.075, stick);
scene.tube_between(-0.723, 2.0, -1.43, -0.723, 2.0, -2.66, 0.075, stick);
scene.tube_between(-0.463, 2.0, -1.43, -0.463, 2.0, -2.66, 0.075, stick);
scene.tube_between(-1.797, 2.0, -0.735, -3.07, 2.0, -1.47, 0.11, stick);
scene.tube_between(-0.593, 2.0, 1.35, -0.593, 2.0, 2.82, 0.11, stick);
scene.tube_between(1.933, 2.0, -1.165, 2.387, 2.0, -2.563, 0.11, stick);
scene.tube_between(2.75, 2.0, -0.04, 3.83, 2.0, -0.04, 0.11, stick);
scene.tube_between(2.855, 2.0, 0.036, 2.038, 2.0, 1.161, 0.075, stick);
scene.tube_between(2.645, 2.0, -0.116, 1.828, 2.0, 1.008, 0.075, stick);
scene.tube_between(0.481, 2.0, 0.655, 0.481, 2.0, -0.735, 0.075, stick);
scene.tube_between(0.741, 2.0, 0.655, 0.741, 2.0, -0.735, 0.075, stick);
scene.tube_between(-3.07, 2.0, -1.47, -3.385, 3.028, -1.652, 0.11, stick);
scene.tube_between(-3.07, 2.0, -1.47, -2.94, 1.486, -2.423, 0.11, stick);
scene.tube_between(-3.07, 2.0, -1.47, -3.83, 1.486, -0.881, 0.11, stick);
scene.tube_between(-0.593, 2.0, 2.82, -0.593, 3.028, 3.184, 0.11, stick);
scene.tube_between(-0.593, 2.0, 2.82, -1.483, 1.486, 3.184, 0.11, stick);
scene.tube_between(-0.593, 2.0, 2.82, 0.297, 1.486, 3.184, 0.11, stick);
scene.tube_between(2.387, 2.0, -2.563, 2.5, 3.028, -2.909, 0.11, stick);
scene.tube_between(2.387, 2.0, -2.563, 3.346, 1.486, -2.634, 0.11, stick);
scene.tube_between(2.387, 2.0, -2.563, 1.653, 1.486, -3.184, 0.11, stick);
scene.ambient(0.2);
scene.camera(50.0, 0.6, 9.0, 9.5, 0.3, 1.8, 0.2);
scene.directional_light(-0.45, -0.8, -0.5, 0.95);
scene.render_png("images/caffeine-molecule.png", 900, 600);
end _dsl_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/caffeine-molecule.png");
