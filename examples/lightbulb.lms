# Lightbulb
# Ported from the lmfilament example lightbulb (Filament's sun plus point-light sample): this host has one directional light plus ambient, so the bulb is a bright glowing sphere above a glossy metal sphere on a floor.
out = ARGV.len() > 0 ? ARGV[0] : "build/lightbulb.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@latest";
scene.background(0.04, 0.045, 0.06);
let metal = material().color(0.85, 0.85, 0.9).roughness(0.05).specular(1.0).shininess(128.0);
let floor = material().color(0.3, 0.32, 0.36).specular(0.1);
let glow = material().color(1.0, 0.95, 0.7).specular(0.0);
scene.plane(14.0, floor).rotate(-90.0, 0.0, 0.0).translate(0.0, -1.0, 0.0);
scene.sphere(1.0, metal).translate(0.0, 0.0, 0.0);
scene.sphere(0.25, glow).translate(1.4, 1.9, 0.6);
scene.ambient(0.12);
scene.camera(40.0, 0.0, 1.8, 7.5, 0.0, 0.2, 0.0);
scene.directional_light(-0.6, -0.8, -0.3, 0.8);
scene.render_png("images/lightbulb.png", 800, 500);
end _dsl_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/lightbulb.png");
